# .env.example → .env 로 복사한 뒤 실제 값을 채우세요. (.env는 커밋 금지)
SECRET_KEY=아무도-모르는-긴-랜덤-문자열

# CLOVA Studio > API 키 (nv-로 시작)
CLOVA_STUDIO_API_KEY=nv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOVA_STUDIO_MODEL=HCX-005

# CLOVA OCR > Domain > API Gateway 연동
CLOVA_OCR_INVOKE_URL=https://xxxxxxxx.apigw.ntruss.com/custom/v1/00000/xxxxxxxx/general
CLOVA_OCR_SECRET=OCR-Secret-Key
# 선택: 인식 언어 (ko, ja, zh-TW 콤마 구분). 비우면 도메인 설정을 따름
CLOVA_OCR_LANG=
